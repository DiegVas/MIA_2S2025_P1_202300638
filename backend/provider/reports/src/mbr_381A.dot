digraph MBR_Report {
    rankdir=TB;
    node [shape=box, style=filled];
    graph [fontname="Arial", fontsize=12];
    node [fontname="Arial", fontsize=10];
    edge [fontname="Arial"];

    title [label="MBR Report\nDisco3.mia", fillcolor=lightblue, fontsize=14];

    mbr_info [label="MBR Information\nDisk Size: 20.00 MB\nCreation Date: September 4, 2025\nTotal Partitions: 1", fillcolor=lightyellow];

    primary_section [label="PRIMARY PARTITIONS", shape=box, style=filled, fillcolor=lightcyan];
    primary_0 [label="Particion1\nType: Primary\nStatus: Active\nStart: 10362880\nSize: 9.88 MB\nFit: Worst Fit", fillcolor=lightgreen];
    primary_section -> primary_0;

    title -> mbr_info;
    mbr_info -> primary_section;
}
