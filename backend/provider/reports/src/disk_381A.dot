digraph DISK_Report {
    rankdir=TB;
    node [shape=record, style=filled];
    graph [fontname="Arial", fontsize=12];
    node [fontname="Arial", fontsize=10];

    title [label="DISK Report\nDisco3.mia", fillcolor=lightblue, fontsize=14];

    disk_info [label="Tamaño Total: 20.00 MB|Espacio Libre: 50.59%", fillcolor=lightgray];

    disk_structure [label="Estructura del Disco|{Componente|Tamaño|Porcentaje|Detalles}|{MBR|47 bytes|N/A|Master Boot Record}|{Particion1|9.88 MB|49.41%|Partición Primaria}|{Espacio Libre|10.12 MB|50.59%|Espacio no particionado}", fillcolor=lightyellow];

    title -> disk_info;
    disk_info -> disk_structure;
}
